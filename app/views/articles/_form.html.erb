<% if article.errors.any? %>
    <div>
        <h2>
            <%= pluralize(article.errors.count, "error") %> prohibited this article from being saved:
        </h2>
        <ul>
            <% article.errors.each do |error| %>
                <li>
                    <%= error.full_message %>
                </li>
            <% end %>
        </ul>
    </div>
<% end %>


<%= form_for article do |f| %>
    <%= f.text_field :title %>
    <br/>
    <%= f.text_area :content %>
    <br/>
    <%= f.submit %>
<% end %>