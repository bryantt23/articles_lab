<h1><%= @article.title %></h1>
<p><%= @article.content %></p>

<h2>Comments</h2>
<ul>
    <% @article.comments.each do |comment| %>
        <li><%= comment.body %></li>
    <% end%>
</ul>

<p><%= link_to "Back to Articles", articles_path %></p>
<p><%= link_to "Edit Article", edit_article_path(@article) %></p>
<%= button_to "Delete", @article, method: :delete, data: { turbo_confirm: "Are you sure?" } %>